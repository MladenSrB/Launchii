<?xml version="1.0" encoding="utf-8"?>
<!-- The Bubbles widget in other launchers: the tile (BubblesWidget.tile) over its label, like an app icon, sized as
     the host's own icons (HostLook.applyIcon) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubbles_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/bubbles_tile"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/bubbles_widget"
        android:src="@drawable/bubbles_widget_preview" />

    <TextView
        android:id="@+id/bubbles_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="4dp"
        android:textAppearance="@android:style/TextAppearance.DeviceDefault"
        android:ellipsize="end"
        android:maxLines="1"
        android:shadowColor="#66000000"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:text="@string/bubbles_widget"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />
</LinearLayout>
